#!/bin/sh
# Check for C++14 support on Windows
# Armadillo requires C++14 minimum

# Get compiler from R
CXX=$(${R_HOME}/bin${R_ARCH_BIN}/Rscript.exe -e "cat(R.home('bin'))" 2>/dev/null)/R CMD config CXX
if [ -z "$CXX" ]; then
  CXX="g++"
fi

# Test C++14 support
cat > testcxx14.cpp <<EOF
#include <memory>
int main() {
  auto ptr = std::make_unique<int>(42);
  return 0;
}
EOF

CXX14_SUPPORTED="no"

# Try C++14 explicitly
if $CXX -std=c++14 testcxx14.cpp -o testcxx14.exe >/dev/null 2>&1; then
  CXX14_SUPPORTED="yes"
elif $CXX -std=gnu++14 testcxx14.cpp -o testcxx14.exe >/dev/null 2>&1; then
  CXX14_SUPPORTED="yes"
elif $CXX -std=c++17 testcxx14.cpp -o testcxx14.exe >/dev/null 2>&1; then
  CXX14_SUPPORTED="yes"
elif $CXX -std=gnu++17 testcxx14.cpp -o testcxx14.exe >/dev/null 2>&1; then
  CXX14_SUPPORTED="yes"
fi

rm -f testcxx14.cpp testcxx14.exe

if [ "$CXX14_SUPPORTED" = "no" ]; then
  echo ""
  echo "---------------------------------------------------------------------"
  echo "ERROR: C++14 compiler required but not found."
  echo ""
  echo "The Armadillo C++ library requires C++14 or later."
  echo "Your compiler does not appear to support C++14."
  echo ""
  echo "On Windows, this typically means you need:"
  echo "  - R >= 4.2 with Rtools42 or later"
  echo "  - Rtools40 (R 4.0-4.1) uses GCC with C++11 by default"
  echo ""
  echo "Please upgrade to R 4.2+ for full armadillo4r support."
  echo "---------------------------------------------------------------------"
  echo ""
  exit 1
fi

echo "- C++14 support detected"
exit 0
